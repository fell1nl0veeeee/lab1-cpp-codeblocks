#include <iostream>
#include <cstring>
using namespace std;

int main()
{
    char text[256];

    cout << "Enter a sentence: ";
    cin.getline(text, 256);

    char* word = strtok(text, " .");

    cout << "\nWords with the same first and last letters:" << endl;

    while (word != NULL)
    {
        int length = strlen(word);

        if (length > 0 && word[0] == word[length - 1])
        {
            cout << word << endl;
        }

        word = strtok(NULL, " .");
    }

    return 0;
}
