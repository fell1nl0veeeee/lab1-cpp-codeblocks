#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main()
{
    double a[100][100];
    int n, m;

    cout << "Enter number of rows: ";
    cin >> n;

    cout << "Enter number of columns: ";
    cin >> m;

    srand(time(0));

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            a[i][j] = (rand() % 201 - 100) / 10.0;
        }
    }

    cout << "\nArray:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            cout << a[i][j] << "\t";
        }
        cout << endl;
    }

    double product = 1;

    int size = n < m ? n : m;

    for (int i = 0; i < size; i++)
    {
        product *= a[i][i];
    }

    double result = product + a[1][0];

    cout << "\nProduct of diagonal elements: " << product << endl;
    cout << "Second element in first column: " << a[1][0] << endl;
    cout << "Sum: " << result << endl;

    return 0;
}
