#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main()
{
    int a[100][100];
    int n, m;

    cout << "Enter number of rows: ";
    cin >> n;

    cout << "Enter number of columns: ";
    cin >> m;

    srand(time(0));

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            a[i][j] = rand() % 21 - 10;
        }
    }

    cout << "\nArray:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            cout << a[i][j] << "\t";
        }
        cout << endl;
    }

    cout << "\nColumns without positive elements: ";

    bool found = false;

    for (int j = 0; j < m; j++)
    {
        bool positive = false;

        for (int i = 0; i < n; i++)
        {
            if (a[i][j] > 0)
            {
                positive = true;
                break;
            }
        }

        if (!positive)
        {
            cout << j + 1 << " ";
            found = true;
        }
    }

    if (!found)
    {
        cout << "There are no such columns";
    }

    cout << endl;

    return 0;
}
