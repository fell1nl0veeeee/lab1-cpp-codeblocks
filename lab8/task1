#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

void processRow(int* row, int m, int number, int& totalSum)
{
    int positiveCount = 0;
    int rowSum = 0;

    for (int j = 0; j < m; j++)
    {
        if (row[j] > 0)
        {
            positiveCount++;
            rowSum += row[j];
        }
    }

    if (positiveCount == 2)
    {
        cout << "Row " << number << ": ";

        for (int j = 0; j < m; j++)
        {
            cout << row[j] << " ";
        }

        cout << " | Sum of positive elements: " << rowSum << endl;

        totalSum += rowSum;
    }
}

int main()
{
    int n, m;

    cout << "Enter number of rows: ";
    cin >> n;

    cout << "Enter number of columns: ";
    cin >> m;

    int** a = new int*[n];

    for (int i = 0; i < n; i++)
    {
        a[i] = new int[m];
    }

    srand(time(0));

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            a[i][j] = rand() % 21 - 10;
        }
    }

    cout << "\nArray:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            cout << a[i][j] << "\t";
        }

        cout << endl;
    }

    int totalSum = 0;

    cout << "\nRows with exactly two positive elements:" << endl;

    for (int i = 0; i < n; i++)
    {
        processRow(a[i], m, i + 1, totalSum);
    }

    cout << "\nTotal sum: " << totalSum << endl;

    for (int i = 0; i < n; i++)
    {
        delete[] a[i];
    }

    delete[] a;

    return 0;
}
