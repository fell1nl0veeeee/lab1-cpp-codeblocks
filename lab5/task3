#include <iostream>
using namespace std;

int main()
{
    int total = 400;
    int count = 0;

    cout << "All possible variants:\n\n";

    for (int a = 0; a <= total / 2; a++)
    {
        for (int b = 0; b <= total / 4; b++)
        {
            for (int c = 0; c <= total / 6; c++)
            {
                if (a * 2 + b * 4 + c * 6 == total)
                {
                    cout << "2t trucks: " << a
                         << " | 4t trucks: " << b
                         << " | 6t trucks: " << c << endl;

                    count++;
                }
            }
        }
    }

    cout << "\nTotal variants: " << count << endl;

    return 0;
}
