#include <iostream>
using namespace std;

int main()
{
    int n, m;
    int sum = 0;

    cout << "Enter n: ";
    cin >> n;

    cout << "Enter m: ";
    cin >> m;

    int i = n;

    while (i <= m)
    {
        if (i >= 10 && i <= 99 && i % 4 == 0 && i % 6 == 0)
        {
            sum += i * i;
        }

        i++;
    }

    cout << "\nSum of squares = " << sum << endl;

    return 0;
}
