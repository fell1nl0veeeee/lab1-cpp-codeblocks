#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main()
{
    double a[100];
    int n;

    cout << "Enter array size: ";
    cin >> n;

    srand(time(0));

    for (int i = 0; i < n; i++)
    {
        a[i] = (rand() % 201 - 100) / 10.0;
    }

    cout << "\nArray:" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    int count = 0;

    cout << "\n\nPositive elements:" << endl;

    for (int i = 0; i < n; i++)
    {
        if (a[i] > 0)
        {
            cout << a[i] << " ";
            count++;
        }
    }

    cout << "\n\nNumber of positive elements: " << count << endl;

    return 0;
}
