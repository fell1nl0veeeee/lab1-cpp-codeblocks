#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main()
{
    double a, b, h, y;

    cout << "Enter a: ";
    cin >> a;

    cout << "Enter b: ";
    cin >> b;

    cout << "Enter h: ";
    cin >> h;

    if (a <= 0 || b < a || h <= 0)
    {
        cout << "Incorrect input!" << endl;
        return 0;
    }

    cout << "\n-----------------------------------" << endl;
    cout << setw(12) << "x" << setw(18) << "Y" << endl;
    cout << "-----------------------------------" << endl;

    for (double x = a; x <= b + h * 0.000001; x += h)
    {
        y = cos(x) + log(x) - exp(x);

        cout << setw(12) << fixed << setprecision(2) << x
             << setw(18) << setprecision(4) << y << endl;
    }

    cout << "-----------------------------------" << endl;

    return 0;
}
