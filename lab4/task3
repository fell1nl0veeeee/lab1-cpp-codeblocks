#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main()
{
    double a, b, h, y;

    cout << "Enter a: ";
    cin >> a;

    cout << "Enter b: ";
    cin >> b;

    cout << "Enter h: ";
    cin >> h;

    cout << "\n      x          Y" << endl;

    for (double x = a; x <= b + 0.000001; x += h)
    {
        y = cos(x) + log(x) - exp(x);

        cout << fixed << setprecision(2) << x
             << "       " << setprecision(4) << y << endl;
    }

    return 0;
}
